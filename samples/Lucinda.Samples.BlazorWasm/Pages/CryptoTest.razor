    private async Task<KeyStorageTestResult> TestKeyStorage()
    {
        try
        {
            var keyId = $"test-key-{Guid.NewGuid():N}";
            var keyData = System.Text.Encoding.UTF8.GetBytes("test-key-material-12345678901234");

            var metadata = new BlazorKeyMetadata
            {
                KeyId = keyId,
                Algorithm = "AES-GCM",
                KeyType = BlazorKeyType.Symmetric,
                CreatedAt = DateTime.UtcNow
            };

            var stored = await KeyStorage.StoreKeyAsync(keyId, keyData, metadata);
            var retrieved = await KeyStorage.RetrieveKeyAsync(keyId);
            var keysMatch = retrieved != null && retrieved.SequenceEqual(keyData);
            await KeyStorage.DeleteKeyAsync(keyId);
            var afterDelete = await KeyStorage.RetrieveKeyAsync(keyId);

            return new KeyStorageTestResult
            {
                KeyId = keyId,
                Stored = stored,
                Retrieved = retrieved != null,
                KeysMatch = keysMatch,
                Deleted = afterDelete == null,
                Success = stored && keysMatch && afterDelete == null
            };
        }
        catch (Exception ex) { return new KeyStorageTestResult { Error = ex.Message }; }
    }

    private async Task<SessionStorageTestResult> TestSessionStorage()
    {
        try
        {
            var sessionId = $"test-session-{Guid.NewGuid():N}";
            var sessionData = System.Text.Encoding.UTF8.GetBytes("{\"test\":\"session-data\"}");

            var stored = await SessionStorage.StoreSessionAsync(sessionId, sessionData);
            var retrieved = await SessionStorage.LoadSessionAsync(sessionId);
            var dataMatch = retrieved != null && retrieved.SequenceEqual(sessionData);
            await SessionStorage.DeleteSessionAsync(sessionId);
            var afterDelete = await SessionStorage.LoadSessionAsync(sessionId);

            return new SessionStorageTestResult
            {
                SessionId = sessionId,
                Stored = stored,
                Retrieved = retrieved != null,
                DataMatch = dataMatch,
                Deleted = afterDelete == null,
                Success = stored && dataMatch && afterDelete == null
            };
        }
        catch (Exception ex) { return new SessionStorageTestResult { Error = ex.Message }; }
    }

